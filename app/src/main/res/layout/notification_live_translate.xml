<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <!-- Left Side: Waveform + Timer -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Animated / Static Waveform bars -->
        <ImageView
            android:id="@+id/notif_waveform"
            android:layout_width="56dp"
            android:layout_height="26dp"
            android:contentDescription="Recording Waveform"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_waveform" />

        <!-- Timer Display (e.g., 00:05) -->
        <TextView
            android:id="@+id/notif_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:includeFontPadding="false"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Side: Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Play / Pause Action Button -->
        <ImageButton
            android:id="@+id/notif_btn_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_notif_circle_dark"
            android:contentDescription="Pause or Resume Recording"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_pause" />

        <!-- Stop Action Button -->
        <ImageButton
            android:id="@+id/notif_btn_stop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_notif_circle_red"
            android:contentDescription="Stop Recording"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_stop" />
    </LinearLayout>

</LinearLayout>
